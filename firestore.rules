rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsTrip(tripId) {
      return signedIn()
          && get(/databases/$(database)/documents/trips/$(tripId))
              .data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, create, update, delete:
          if signedIn() && request.auth.uid == userId;

      match /expenses/{expenseId} {
        allow read, create, update, delete:
            if signedIn() && request.auth.uid == userId;
      }
    }

    match /trips/{tripId} {
      allow create:
          if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, delete:
          if signedIn() && resource.data.userId == request.auth.uid;
      allow update:
          if signedIn()
              && resource.data.userId == request.auth.uid
              && request.resource.data.userId == resource.data.userId;

      match /{subcollection}/{document=**} {
        allow read, write: if ownsTrip(tripId);
      }
    }

    match /touristPlaces/{placeId} {
      allow read: if signedIn();
      allow write: if false;
    }
  }
}
